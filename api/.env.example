# Development lokal — salin ke .env. Nilai diambil dari repo lama agar
# token JWT & sealed secret KOMPATIBEL saat parallel run (REWRITE/00 §5).
APP_ENV=development
APP_NAME=AI Writer
APP_VERSION=0.2.0-go
API_PORT=8080

# WAJIB sama dengan APP_SECRET app lama (compat JWT HS256 + unseal v1/v2/v3).
APP_SECRET=local-development-secret-change-before-production-2026
CMS_ENCRYPTION_SECRET=local-development-secret-change-before-production-2026

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_MINUTES=43200

# DB terpisah untuk rewrite (REWRITE/03_DATABASE.md)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tauthub-go
DB_USER=ai_writer
DB_PASSWORD=ai_writer_local_2026
DB_POOL_SIZE=10

PLATFORM_ADMIN_EMAILS=wantek@gmail.com
AUTH_RATE_LIMIT_PER_MINUTE=10
WRITE_RATE_LIMIT_PER_MINUTE=120

JOB_INLINE=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAX_JOBS=20

AI_PROVIDER=sumopod
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
