# Development lokal — salin ke .env. Nilai diambil dari repo lama agar
# token JWT & sealed secret KOMPATIBEL saat parallel run (REWRITE/00 §5).
APP_ENV=development
APP_NAME=AI Writer
APP_VERSION=0.2.0-go
API_PORT=8080

# WAJIB sama dengan APP_SECRET app lama (compat JWT HS256 + unseal v1/v2/v3).
APP_SECRET=local-development-secret-change-before-production-2026
CMS_ENCRYPTION_SECRET=ganti-dengan-secret-32-karakter-anda

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_MINUTES=43200

# DB terpisah untuk rewrite (REWRITE/03_DATABASE.md)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tauthub-go
DB_USER=ai_writer
DB_PASSWORD=ganti-dengan-password-db-lokal-anda
DB_POOL_SIZE=10

PLATFORM_ADMIN_EMAILS=wantek@gmail.com
AUTH_RATE_LIMIT_PER_MINUTE=10
WRITE_RATE_LIMIT_PER_MINUTE=120

JOB_INLINE=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAX_JOBS=20
WORKER_POLL_SECONDS=5

# JOB_INLINE hanya berlaku untuk job domain `content` (internal/domains/content/jobs.go).
# Job `publication_execution` TIDAK ikut inline: antrean `jobs` hanya terkuras oleh
# proses cmd/worker atau cmd/scheduler. Jalankan salah satunya supaya publikasi
# benar-benar dikirim ke CMS mitra (kalau tidak, publikasi berhenti di `queued`).
#   cd api && ./bin/worker      # penguras antrean
#   cd api && ./bin/scheduler   # penguras + materialisasi jadwal + sweep pengingat
JOB_RUNNER_KEY=ganti-dengan-random-hex-48-karakter
CRON_SECRET=ganti-dengan-random-hex-48-karakter

AI_PROVIDER=sumopod
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
