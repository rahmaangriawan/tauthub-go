[Unit]
Description=Tauthub staging web (SvelteKit adapter-node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tauthub
Group=tauthub
WorkingDirectory=__APP_DIR__/web
EnvironmentFile=__APP_DIR__/.env
Environment=NODE_ENV=production
Environment=PORT=__WEB_PORT__
Environment=HOST=127.0.0.1
# JANGAN set ORIGIN di sini. adapter-node memakai ORIGIN sebagai basis URL
# untuk SEMUA request dan mengabaikan header host — akibatnya SvelteKit selalu
# melihat satu host saja, sehingga situs kedua (data.tauthub.com) ikut tampil
# sebagai host aplikasi (redirect ke /login). Dengan hanya dua header di bawah,
# origin dihitung per request dari nginx: https://app.tauthub.com untuk
# dashboard dan https://data.tauthub.com untuk katalog publik. CSRF/form action
# tetap benar karena SvelteKit membandingkan Origin dengan origin request itu.
# __WEB_PORT__ diisi deploy/setup-vps.sh per environment.
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
ExecStart=/usr/bin/node build
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
