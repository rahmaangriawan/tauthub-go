[Unit]
Description=Tauthub staging scheduler (drain job + materialisasi plan + sweep)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tauthub
Group=tauthub
WorkingDirectory=__APP_DIR__/api
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/api/bin/scheduler
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
