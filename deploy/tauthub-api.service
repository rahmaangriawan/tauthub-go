[Unit]
Description=Tauthub staging API (Go)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tauthub
Group=tauthub
WorkingDirectory=__APP_DIR__/api
EnvironmentFile=__APP_DIR__/.env
# Soft limit memori Go: GC jadi lebih agresif hanya saat mendekati batas, sehingga
# proses tidak di-OOM-killer kernel dan tidak memboroskan CPU saat memori longgar.
# VPS 2 GB + swap 2 GB: 512MiB per proses Go (api/scheduler) masih menyisakan
# ruang untuk PostgreSQL + nginx. Naikkan ke 768MiB bila VPS di-upgrade.
Environment=GOMEMLIMIT=512MiB
# Path upload absolut — sebelumnya relatif working directory (.data/uploads
# di bawah cwd service). Nilai sama dengan path efektif lama, jadi berkas
# yang sudah ada tetap terbaca.
Environment=UPLOAD_DIR=__APP_DIR__/api/.data/uploads
Environment=LEGACY_UPLOAD_DIR=__APP_DIR__/web/public/uploads
ExecStart=__APP_DIR__/api/bin/api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
