.env
*.env.local

# Go
api/bin/

# Node / SvelteKit
node_modules/
web/.svelte-kit/
web/build/

# data & log
data/
*.log
.DS_Store

# cadangan rahasia jangan pernah ikut ter-commit
.env.bak*
*.env.bak*

# Unggahan runtime: hanya GAMBAR yang ikut ke repo (seed/backup untuk deploy
# via GitHub Actions). Dokumen (pdf/txt/csv/…) tetap lokal karena bisa memuat
# berkas sensitif mitra.
.data/*
!.data/uploads/
.data/uploads/*
!.data/uploads/*.webp
!.data/uploads/*.png
!.data/uploads/*.jpg
!.data/uploads/*.jpeg
!.data/uploads/*.gif
!.data/uploads/*.svg
api/.data/*
!api/.data/uploads/
api/.data/uploads/*
!api/.data/uploads/*.webp
!api/.data/uploads/*.png
!api/.data/uploads/*.jpg
!api/.data/uploads/*.jpeg
!api/.data/uploads/*.gif
!api/.data/uploads/*.svg

# lockfile npm: proyek web memakai Bun (web/bun.lock)
package-lock.json

# fixture compat dihasilkan lokal oleh harness (memuat token, seal, dan hash
# yang diturunkan dari APP_SECRET/CMS_ENCRYPTION_SECRET) — jangan pernah di-commit
api/compat/fixtures.json
api/compat/go-output.json
api/compat/embed-fixtures.json

# Cache skill tool (agent/Claude/Codex): berisi salinan skill pihak ketiga,
# bukan kode aplikasi. Tiap mesin punya sendiri.
.agents/
.claude/
agent/
